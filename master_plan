### Hướng dẫn Manim cơ bản:

```python
# Cấu trúc file — mỗi Scene class = 1 scene video riêng
from manim import *
from config import *

class Scene05_2DVAE_Problem(Scene):
    def construct(self):
        title = make_title("Vấn đề: 2D VAE truyền thống")
        self.play(Write(title))
        self.wait(1)
        
        frames = VGroup(*[
            Rectangle(width=2, height=1.5, color=BLUE, fill_opacity=0.3)
            for _ in range(5)
        ]).arrange(RIGHT, buff=0.3).shift(DOWN * 0.5)
        
        self.play(LaggedStart(*[FadeIn(f) for f in frames], lag_ratio=0.2))
        
        # Mũi tên độc lập cho mỗi frame
        arrows = VGroup(*[
            Arrow(f.get_bottom(), f.get_bottom() + DOWN*0.8, 
                  color=C_RED, stroke_width=2)
            for f in frames
        ])
        self.play(LaggedStart(*[Create(a) for a in arrows], lag_ratio=0.1))
        
        error = Text("✗ Nhấp nháy & biến dạng!", font=FONT, 
                     font_size=28, color=C_RED)
        error.to_edge(DOWN)
        self.play(Write(error))
        self.wait(3)
        self.play(*[FadeOut(m) for m in self.mobjects])

# Render: manim -pql scenes/part1_video_generation.py Scene05_2DVAE_Problem
```

